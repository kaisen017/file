readmeXML.js:
const fs = require("fs"); 
const xml2js = require("xml2js"); 
// Read XML file 
const xmlData = fs.readFileSync("stu.xml", "utf-8"); 
 
// Parse XML 
const parser = new xml2js.Parser(); 
parser.parseString(xmlData, (err, result) => { 
    if (err) throw err; 
    const students = result.students.student; 
    students.forEach(s => { 
        console.log("Name:", s.name[0]); 
        console.log("Course:", s.course[0]); 
        console.log("----------------------------"); 
    }); 
});

--> Terminal:
npm install xml2js  
node readXML.js
