6. Registration form:
<!DOCTYPE html> 
<html> 
<head>    <title>Registration Form</title> <style> 
    body { 
        font-family: Arial, sans-serif; 
        background: #f2f2f2; 
        margin: 0; 
        padding: 0; 
    } 
    .container { 
        width: 350px; 
        background: white; 
        padding: 20px; 
        margin: 50px auto; 
        border-radius: 10px; 
        box-shadow: 0 0 10px #aaa; 
    } 
    h2 { 
        text-align: center; 
        color: #333; 
    } 
    label { 
        display: block; 
        margin-top: 10px; 
        font-weight: bold; 
    } 
    input { 
        width: 100%; 
        padding: 7px; 
        margin-top: 5px; 
        border-radius: 5px; 
        border: 1px solid #ccc; 
        box-sizing: border-box; 
    } 
    button { 
        width: 100%; 
        padding: 10px; 
        margin-top: 15px; 
        background: #0275d8; 
        color: white; 
        border: none; 
        border-radius: 5px; 
     font-size: 16px; 
        cursor: pointer; 
    } 
    button:hover { 
        background: #025aa5; 
    } 
    #notification { 
        margin-top: 15px; 
        padding: 10px; 
        background: #d4edda; 
        color: #155724; 
        border-radius: 5px; 
        display: none; 
        text-align: center; 
    } 
</style> 
    <script> 
        function validateForm(event) { 
            event.preventDefault(); // prevent default form submission       
            var name = document.getElementById("name").value.trim(); 
            var place = document.getElementById("place").value.trim(); 
            var email = document.getElementById("email").value.trim(); 
            var phone = document.getElementById("phone").value.trim(); 
            if(name === "") { alert("Enter Name"); return; } 
            if(place === "") { alert("Enter College/Place"); return; } 
            if(email === "") { alert("Enter Email"); return; } 
            var emailPattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/; 
            if(!emailPattern.test(email)) { alert("Invalid Email"); return; } 
            if(phone === "" || phone.length != 10 || isNaN(phone)) { alert("Invalid Phone"); return; } 
            // Display notification 
            var note = document.getElementById("notification"); 
            note.innerHTML = `Thank you ${name}! Your registration is successful.`; 
            note.style.display = "block"; 
            // Optional: Clear the form 
            document.getElementById("regForm").reset(); 
        } 
    </script></head><body> 
<div class="container"> 
    <h2>Registration Form</h2> 
    <form id="regForm" onsubmit="validateForm(event)"> 
        <label>Name:</label> 
        <input type="text" id="name" placeholder="Enter your full name"> 
        <label>College/Place:</label> 
        <input type="text" id="place" placeholder="Enter your college/place"> 
        <label>Email:</label> 
        <input type="email" id="email" placeholder="Enter your email"> 
        <label>Phone Number:</label> 
        <input type="text" id="phone" placeholder="Enter 10-digit phone number"> 
        <button type="submit">Submit</button> 
    </form> 
    <div id="notification"></div> 
</div> 
</body> 
</html>
