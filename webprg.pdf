1. College website:
<!DOCTYPE html> 
<html lang="en"> 
<head> 
    <meta charset="UTF-8"> 
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
    <title>Bharathiyar University</title> 
    <style> 
        body { 
 
            font-family: Arial, sans-serif; 
            margin: 0; 
            background: #f4f6f9; 
        } 
        header { 
            background: #002147; 
            color: white; 
            padding: 20px; 
            text-align: center; 
        } 
        nav { 
            background: #064579; 
            padding: 10px; 
        } 
        nav a { 
            color: white; 
            margin: 15px; 
            text-decoration: none; 
            font-weight: bold; 
        } 
        section { 
            padding: 20px; 
        } 
        article { 
            background: white; 
            padding: 20px; 
            margin-bottom: 20px; 
            border-radius: 5px; 
 
        } 
        footer { 
            background: #002147; 
            color: white; 
            text-align: center; 
            padding: 10px; 
        } 
        table { 
            width: 100%; 
            border-collapse: collapse; 
            background: white; 
        } 
        th, td { 
            padding: 12px; 
            border: 1px solid #ccc; 
        } 
        iframe { 
            width: 100%; 
            height: 300px; 
            border: none; 
        } 
    </style> 
</head> 
<body> 
<header> 
    <h1> Bharathiyar University </h1> 
    <p>"Educate, Empower, Enlighten"</p> 
</header> 
<nav> 
    <a href="#about">About</a> 
    <a href="#courses">Courses</a> 
    <a href="#contact">Contact</a> 
</nav> 
<section id="about"> 
    <article> 
        <h2>About Our University</h2> 
        <p>Bharathiyar University is one of the leading educational institutions offering quality 
education in arts, science, engineering and advanced research.</p> 
        <!-- Advanced HTML Tag: <details> --> 
        <details> 
            <summary>Read More About Our History</summary> 
            <p>Founded in 1982, the university is named after the great Tamil poet Subramania 
Bharathiyar.</p> 
        </details> 
    </article> 
</section> 
<section id="courses"> 
    <article> 
        <h2>Available Courses</h2> 
        <!-- Advanced HTML Tag: Table --> 
        <table> 
            <tr> 
                <th>Course Name</th> 
                <th>Duration</th> 
                <th>Type</th> 
            </tr> 
            <tr> 
                <td>B.Sc Computer Science</td> 
                <td>3 Years</td> 
                <td>Full-time</td> 
            </tr> 
            <tr> 
                <td>BBA</td> 
                <td>3 Years</td> 
                <td>Full-time</td> 
            </tr> 
            <tr> 
                <td>MCA</td> 
                <td>2 Years</td> 
                <td>Post Graduate</td> 
            </tr> 
        </table> 
    </article> 
</section> 
<section id="contact"> 
    <article> 
        <h2>Contact Us</h2> 
        <!-- Advanced HTML Tag: HTML5 Form --> 
        <form> 
            <label>Name: </label> 
            <input type="text" placeholder="Enter your name" required><br><br> 
            <label>Email: </label> 
            <input type="email" placeholder="Enter your email" required><br><br> 
            <label>Message: </label><br> 
            <textarea rows="5" cols="40"></textarea><br><br> 
            <button type="submit">Submit</button> 
        </form> 
    </article> 
</section> 
<footer> 
    <p>© 2025 Bharathiyar University. All Rights Reserved.</p> 
</footer> 
</body> 
</html>  
