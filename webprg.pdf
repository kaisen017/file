5. Biodata:
<!DOCTYPE html> 
<html> 
<head>    <title>Personal Bio-Data Form</title>    <style> 
        body { 
            font-family: "Segoe UI", sans-serif; 
            background: #f0f5ff; 
            margin: 0; 
            padding: 0; 
        } 
        .container { 
            width: 450px; 
            background: white; 
            padding: 25px; 
            margin: 40px auto; 
            border-radius: 12px; 
            box-shadow: 0 0 15px rgba(0,0,0,0.2); 
        } 
        h2 { 
            text-align: center; 
            color: #003d99; 
            margin-bottom: 20px; 
        } 
        label { 
            font-weight: bold; 
            display: block; 
            margin-top: 10px; 
        } 
        input, textarea, button, select { 
            width: 100%; 
            padding: 8px; 
            margin-top: 5px; 
            border-radius: 6px; 
            border: 1px solid #aaa; 
        } 
        button { 
            background: #003d99; 
            color: white; 
            border: none; 
            margin-top: 15px; 
            font-size: 16px; 
            cursor: pointer; 
            padding: 10px; 
        } 
        button:hover { 
            background: #002b73; 
        } 
        #result { 
            margin-top: 25px; 
            padding: 20px; 
            background: #e6f0ff; 
            border-left: 4px solid #003d99; 
            border-radius: 8px; 
        } 
        p { 
            margin: 6px 0; 
        } 
    </style>    <script> 
        function showData() { 
            document.getElementById("result").innerHTML = ` 
                <h3>Your Bio-Data</h3> 
                <p><b>Full Name:</b> ${document.getElementById("name").value}</p> 
 
                <p><b>Date of Birth:</b> ${document.getElementById("dob").value}</p> 
                <p><b>Gender:</b> 
${document.querySelector('input[name="gender"]:checked')?.value}</p> 
                <p><b>Email:</b> ${document.getElementById("email").value}</p> 
                <p><b>Phone Number:</b> ${document.getElementById("phone").value}</p> 
                <p><b>Address:</b> ${document.getElementById("address").value}</p> 
                <p><b>City:</b> ${document.getElementById("city").value}</p> 
                <p><b>State:</b> ${document.getElementById("state").value}</p> 
                <p><b>Qualifications:</b> ${document.getElementById("qual").value}</p> 
                <p><b>Hobbies:</b> ${document.getElementById("hobbies").value}</p>  `; 
        }    </script> </head> <body> 
 
<div class="container"> 
    <h2>Personal Bio-Data Form</h2> 
    <label>Full Name:</label> 
    <input type="text" id="name"> 
    <label>Date of Birth:</label> 
    <input type="date" id="dob"> 
    <label>Gender:</label> 
    <input type="radio" name="gender" value="Male"> Male   
    <input type="radio" name="gender" value="Female"> Female   
    <input type="radio" name="gender" value="Other"> Other   
    <label>Email:</label> 
    <input type="email" id="email"> 
    <label>Phone Number:</label> 
    <input type="text" id="phone"> 
    <label>Address:</label> 
    <textarea id="address" rows="3"></textarea> 
    <label>City:</label> 
    <input type="text" id="city"> 
    <label>State:</label> 
    <input type="text" id="state"> 
    <label>Qualifications:</label> 
    <textarea id="qual" rows="3"></textarea>    <label>Hobbies:</label> 
    <textarea id="hobbies" rows="3"></textarea> 
 
    <button onclick="showData()">Submit</button> 
    <div id="result"></div>  </div> </body> </html>
