Source Code:
<?php
// Grandparent class
class Person
{
protected $name;
function __construct($n)
{
$this->name = $n;
echo "Person Constructor Called<br>";
}
}
// Parent class
class Employee extends Person
{
protected $salary;
function __construct($n, $s)
{
parent::__construct($n);
$this->salary = $s;
echo "Employee Constructor Called<br>";
}
}
// Child class
class Manager extends Employee
{
private $department;
function __construct($n, $s, $d)
{
parent::__construct($n, $s);
$this->department = $d;
echo "Manager Constructor Called<br>";
}
function display()
{
echo "<br><b>Details:</b><br>";
echo "Name: " . $this->name . "<br>";
echo "Salary: " . $this->salary . "<br>";
echo "Department: " . $this->department . "<br>";
}
}
// Object creation
$mgr = new Manager("Vishnu", 60000, "IT");
$mgr->display();
